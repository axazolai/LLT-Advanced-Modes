<wpfui:UiPage
    x:Class="LegionModes.Plugin.Ui.ModesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LegionModes.Plugin.Ui"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Scrollable="False">
    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <TextBlock
            x:Name="_waiting"
            Margin="16"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Grid x:Name="_body" Margin="16,12,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- LLT's segmented tab strip (Styles/SegmentedControl.xaml); the tabs carry only headers, the selected tab's
                 element (its Tag) is shown below the in-force line. -->
            <TabControl
                x:Name="_tabs"
                Grid.Row="0"
                Padding="0"
                HorizontalAlignment="Left"
                ItemContainerStyle="{DynamicResource SegmentedControlItemStyle}"
                Style="{DynamicResource SegmentedControlStyle}">
                <TabItem />
                <TabItem />
                <TabItem />
                <TabItem />
                <TabItem />
            </TabControl>
            <!-- The profile in force, shown on the Профили tab only. -->
            <Border x:Name="_inForceBar" Grid.Row="1" Margin="0,8,16,0" Padding="12,8" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <wpfui:SymbolIcon x:Name="_inForceIcon" Foreground="{DynamicResource PaletteGreenBrush}" Style="{StaticResource RowIcon}" Symbol="CheckmarkCircle24" />
                        <TextBlock x:Name="_inForceLabel" Margin="0,0,8,0" Style="{StaticResource RowLabel}" />
                        <TextBlock x:Name="_inForceName" Margin="0,0,12,0" Style="{StaticResource ItemName}" />
                        <TextBlock x:Name="_inForceReason" Style="{StaticResource SubLine}" />
                    </StackPanel>
                    <wpfui:Button x:Name="_effectiveButton" Grid.Column="1" Margin="12,0,0,0" Icon="Flowchart24" />
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <local:StatusTab x:Name="_statusTab" />
                <local:ProfilesTab x:Name="_profilesTab" Visibility="Collapsed" />
                <local:ProgramsTab x:Name="_programsTab" Visibility="Collapsed" />
                <local:UpdatesTab x:Name="_updatesTab" Visibility="Collapsed" />
                <local:ControlTab x:Name="_controlTab" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</wpfui:UiPage>
